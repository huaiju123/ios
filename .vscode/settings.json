{
  "files.exclude": {
    "**/build": true,
    "**/DerivedData": true,
    "**/.build": true,
    "**/xcuserdata": true,
    "**/.DS_Store": true
  },
  "search.exclude": {
    "**/build": true,
    "**/DerivedData": true,
    "**/.build": true
  },
  "editor.rulers": [120],
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "[swift]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.formatOnSave": false
  },
  "[json]": {
    "editor.tabSize": 2
  },
  "[yaml]": {
    "editor.tabSize": 2
  }
}
